GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swarm
SESSION_SECRET=replace_with_a_long_random_secret
# LiteLLM direct SDK routing. Use a provider/model string for each agent.
# Supply LLM_<AGENT>_API_KEY to use distinct credentials, or leave it blank
# to use the provider's standard API key (for example, GROQ_API_KEY).
LLM_ANALYST_MODEL=groq/openai/gpt-oss-120b
LLM_ANALYST_API_KEY=
LLM_ANALYST_FALLBACK_MODELS=groq/llama-3.3-70b-versatile
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_ARCHITECT_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
LLM_ARCHITECT_API_KEY=${NVIDIA_NIM_API_KEY}
LLM_ARCHITECT_FALLBACK_MODELS=
LLM_PITCHER_MODEL=groq/openai/gpt-oss-120b
LLM_PITCHER_API_KEY=
LLM_PITCHER_FALLBACK_MODELS=groq/llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=90
LLM_RATE_LIMIT_RETRY_SECONDS=30
LLM_REQUEST_TOKEN_BUDGET=16000
LLM_ANALYST_MAX_TOKENS=3000
LLM_ARCHITECT_MAX_TOKENS=7000
LLM_ARCHITECT_REPAIR_MAX_TOKENS=8000
LLM_PITCHER_MAX_TOKENS=1200
# OpenHands is the required architecture-aware implementation stage after
# the deterministic schema/API/UI baseline has been generated.
OPENHANDS_ENABLED=true
OPENHANDS_MODEL=openrouter/cohere/north-mini-code:free
OPENHANDS_API_KEY=
OPENHANDS_BUILDER_REQUIRED=true
OPENHANDS_BUILDER_MAX_OUTPUT_TOKENS=2000
OPENHANDS_REVIEW_TIMEOUT_SECONDS=90
OPENHANDS_REVIEW_MAX_ITERATIONS=12
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b
GROQ_TIMEOUT_SECONDS=90
GROQ_RATE_LIMIT_RETRY_SECONDS=30
GROQ_REQUEST_TOKEN_BUDGET=12000
GROQ_ANALYST_MAX_TOKENS=3000
GROQ_ARCHITECT_MAX_TOKENS=3500
GROQ_ARCHITECT_REPAIR_MAX_TOKENS=4500
GROQ_BUILDER_MAX_TOKENS=6000
GROQ_BUILDER_REPAIR_MAX_TOKENS=6000
GROQ_PITCHER_MAX_TOKENS=1200
SWARM_BUILDER_MODE=llm
SWARM_BUILDER_USE_LLM=true
SWARM_BUILDER_ALLOW_TEMPLATE_FALLBACK=false
SWARM_ALLOW_LLM_FALLBACK=false
SWARM_ALLOW_ARCHITECT_CONTRACT_FALLBACK=false
SWARM_ARCHITECT_REPAIR_ATTEMPTS=2
SWARM_ALLOW_BAKERY_WEBSITE_FALLBACK=false
SWARM_ALLOW_SALOON_WEBSITE_FALLBACK=false
