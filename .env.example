GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swarm
SESSION_SECRET=replace_with_a_long_random_secret
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b
GROQ_TIMEOUT_SECONDS=90
GROQ_RATE_LIMIT_RETRY_SECONDS=30
GROQ_REQUEST_TOKEN_BUDGET=12000
GROQ_ANALYST_MAX_TOKENS=3000
GROQ_ARCHITECT_MAX_TOKENS=3500
GROQ_ARCHITECT_REPAIR_MAX_TOKENS=4500
GROQ_BUILDER_MAX_TOKENS=6000
GROQ_BUILDER_REPAIR_MAX_TOKENS=6000
GROQ_PITCHER_MAX_TOKENS=1200
SWARM_BUILDER_MODE=llm
SWARM_BUILDER_USE_LLM=true
SWARM_BUILDER_ALLOW_TEMPLATE_FALLBACK=false
SWARM_ALLOW_LLM_FALLBACK=false
SWARM_ALLOW_ARCHITECT_PARSE_FALLBACK=true
SWARM_ALLOW_BAKERY_WEBSITE_FALLBACK=false
SWARM_ALLOW_SALOON_WEBSITE_FALLBACK=false
